# 开发环境无需创建 .env，可直接使用 admin / bookmark-s-demo 登录。
# 此文件用于部署配置：复制为 .env（Node / Docker）或 .dev.vars（本地 Worker）。
# 部署前务必替换下面两个占位值；不要提交包含真实密钥的文件。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy
# 用 openssl rand -hex 32 生成随机值，至少 32 个字符。
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# 以下仅用于 Node / Docker；Cloudflare 的数据库通过 D1 binding 配置。
HOST=0.0.0.0
PORT=8787
DB_PATH=./data/bookmark-s.sqlite

# HTTPS 反向代理部署时，填写浏览器访问的完整站点来源（不含路径）。
# PUBLIC_URL=https://bookmarks.example.com

# 生产环境默认仅通过 HTTPS 发送登录 Cookie。
# 仅在本机通过 HTTP 验证生产构建时取消注释这一行。
# SECURE_COOKIES=false
